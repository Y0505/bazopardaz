# Keep the bot webhook (webhook.php) reachable, but never serve stored orders / chat IDs or error logs.
<FilesMatch "^(data\.json|error_log)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
Options -Indexes
